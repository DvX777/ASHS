{
  "name": "moviesdb",
  "version": "1.0.0",
  "description": "ASHS — Auto Self-Hosted System. Autonomous media library for movies & TV shows.",
  "scripts": {
    "dev":            "bun run --watch src/index.ts",
    "start":          "bun run src/index.ts",
    "migrate":        "bun run scripts/migrate.ts",
    "seed:site":      "bun run scripts/seed-site.ts",
    "import:library": "bun run scripts/import-library.ts"
  },
  "dependencies": {
    "elysia": "^1.3.1",
    "@elysiajs/cors": "^1.3.2",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.2"
  }
}
