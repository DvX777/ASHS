# ── Server Ports ──────────────────────────────────────────
API_PORT=4000
FILE_PORT=4001

# ── Storage Paths ─────────────────────────────────────────
# NVMe — fast disk for DB + temp downloads
DB_PATH=/opt/ashs/db/ashs.sqlite3
TEMP_DIR=/opt/ashs/temp

# HDD — bulk media storage
MEDIA_DIR=/mnt/media

# ── TMDB ──────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ── Security ──────────────────────────────────────────────
# Master admin API key (for /v1/admin/* endpoints)
ADMIN_API_KEY=generate_a_long_random_secret_here

# ── Discord Alerts ────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# ── Ingestion Settings ────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=3
DISK_CLEANUP_THRESHOLD=0.85

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://vidzen.fun,https://cinezo.cc

# ── Environment ───────────────────────────────────────────
NODE_ENV=production
