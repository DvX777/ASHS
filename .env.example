# ASHS Environment Configuration
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────
API_PORT=4000
FILE_PORT=4001

# ── Auth ──────────────────────────────────────────────────────────
# Admin API key — keep secret, used for /v1/admin/* endpoints
ADMIN_API_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Storage paths ─────────────────────────────────────────────────
# Main media storage (21TB HDD)
MEDIA_DIR=/opt/ashs/media

# Fast NVMe for in-progress downloads and DB
TEMP_DIR=/opt/ashs/temp
DB_PATH=/opt/ashs/db/ashs.sqlite3

# ── External APIs ─────────────────────────────────────────────────
# TMDB API key — free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Notifications ─────────────────────────────────────────────────
# Discord webhook URL for download alerts and stats
# Create at: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# ── Download Settings ─────────────────────────────────────────────
# Max simultaneous downloads (recommended: 3-5)
MAX_CONCURRENT_DOWNLOADS=5

# Disk usage % at which downloads pause and cleanup runs (0.0 - 1.0)
DISK_CRITICAL_THRESHOLD=0.85

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins, or * for all
CORS_ORIGINS=*

# ── Backup (optional) ─────────────────────────────────────────────
# Set R2_ENABLED=true and configure rclone remote for cloud backups
R2_ENABLED=false
R2_REMOTE=r2:ashs-backups
BACKUP_DIR=/opt/ashs/db/backups
BACKUP_KEEP_DAYS=7
